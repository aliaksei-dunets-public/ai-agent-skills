{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimizer Result",
  "description": "Canonical machine-readable optimizer result. Finding fields map one-to-one to the Finding Contract in SKILL.md. Human-readable Markdown reports are rendered from the same content.",
  "type": "object",
  "required": ["schema_version", "metadata", "no_material_issue", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "metadata": {
      "type": "object",
      "required": ["mode", "report_language"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["quick", "standard", "deep", "compare", "optimize"]},
        "report_language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "BCP 47 tag of the human-readable prose, for example ru, en, es."
        },
        "artifact": {"type": "string"},
        "evidence_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "no_material_issue": {"type": "boolean"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "validation": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "level": {"enum": ["high", "medium", "low"]},
    "finding": {
      "type": "object",
      "required": ["id", "severity", "confidence", "evidence_type", "problem", "evidence", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^OPT-[0-9]{3,}$"},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "confidence": {"$ref": "#/$defs/level"},
        "evidence_type": {"enum": ["static", "runtime", "metric", "external-guidance", "inference"]},
        "category": {"type": "string", "minLength": 1},
        "problem": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["location", "summary"],
            "additionalProperties": false,
            "properties": {
              "location": {"type": "string", "minLength": 1},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        },
        "impact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tokens": {"$ref": "#/$defs/level"},
            "quality": {"$ref": "#/$defs/level"},
            "stability": {"$ref": "#/$defs/level"},
            "security": {"$ref": "#/$defs/level"},
            "latency": {"$ref": "#/$defs/level"},
            "cost": {"$ref": "#/$defs/level"}
          }
        },
        "root_cause": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "effort": {"enum": ["small", "medium", "large"]},
        "validation": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "measured"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "measured": {"type": "boolean", "description": "false marks an estimate"},
        "value": {"type": ["number", "string"]},
        "before": {"type": ["number", "string"]},
        "after": {"type": ["number", "string"]},
        "unit": {"type": "string"}
      }
    }
  }
}
