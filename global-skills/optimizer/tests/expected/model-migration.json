{
  "rubric": {
    "required": [
      "fresh target-model baseline",
      "one-change-at-a-time eval plan",
      "separate reasoning and verbosity controls",
      "verify model-specific guidance freshness"
    ],
    "forbidden": [
      "assume all GPT-5.4 scaffolding is required for GPT-5.6"
    ]
  },
  "checks": {
    "mode": "compare",
    "min_findings": 1,
    "no_measured_metrics": true,
    "required_concepts": [
      {
        "id": "baseline",
        "any": [
          "baseline"
        ]
      },
      {
        "id": "eval-set",
        "any": [
          "eval",
          "representative (tasks|cases)"
        ]
      },
      {
        "id": "one-change",
        "any": [
          "one (change|variable|factor) at a time",
          "single (change|variable)",
          "independent(ly)? (change|variable)"
        ]
      },
      {
        "id": "verbosity-control",
        "any": [
          "verbosity",
          "reasoning effort"
        ]
      },
      {
        "id": "guidance-freshness",
        "any": [
          "fresh",
          "current (model|documentation|guidance)",
          "stale",
          "verify .*guidance",
          "model-specific"
        ]
      }
    ],
    "forbidden_patterns": [
      {
        "id": "fabricated-savings",
        "pattern": "\\d+(\\.\\d+)?\\s*%\\s*(fewer|less|lower|token|saving|reduction|cheaper)"
      }
    ]
  }
}
