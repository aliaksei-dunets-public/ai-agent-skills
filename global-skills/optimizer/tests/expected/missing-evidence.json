{
  "rubric": {
    "required": [
      "state that evidence is insufficient",
      "lower confidence",
      "no fabricated savings",
      "audit what is available, for example the vague trigger description"
    ],
    "forbidden": [
      "state a precise token saving",
      "invent runtime behavior"
    ]
  },
  "checks": {
    "mode": "quick",
    "max_findings": 3,
    "no_measured_metrics": true,
    "required_concepts": [
      {
        "id": "insufficient-evidence",
        "any": [
          "insufficient",
          "missing",
          "not (provided|available|supplied)",
          "unavailable",
          "cannot (be )?(estimat|measur|determin)",
          "unmeasured",
          "no (body|trace|usage|data)"
        ]
      }
    ],
    "forbidden_patterns": [
      {
        "id": "fabricated-savings",
        "pattern": "\\d+(\\.\\d+)?\\s*%\\s*(fewer|less|lower|token|saving|reduction|cheaper)"
      }
    ]
  }
}
