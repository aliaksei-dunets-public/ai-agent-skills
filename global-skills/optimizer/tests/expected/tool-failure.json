{
  "rubric": {
    "required": [
      "failure masked as success",
      "report failures explicitly",
      "bounded retry and escalation"
    ],
    "forbidden": [
      "recommend hiding errors to shorten output"
    ]
  },
  "checks": {
    "mode": "standard",
    "min_findings": 1,
    "max_findings": 5,
    "no_measured_metrics": true,
    "required_concepts": [
      {
        "id": "masking",
        "any": [
          "mask",
          "hid",
          "suppress",
          "false (success|positive)",
          "report\\w* success",
          "silent"
        ]
      },
      {
        "id": "failure-reporting",
        "any": [
          "report\\w* (the )?(failure|error)",
          "failure status",
          "surface",
          "escalat"
        ]
      },
      {
        "id": "retry-bound",
        "any": [
          "retr",
          "limit",
          "stop condition"
        ]
      }
    ],
    "forbidden_patterns": [
      {
        "id": "fabricated-savings",
        "pattern": "\\d+(\\.\\d+)?\\s*%\\s*(fewer|less|lower|token|saving|reduction|cheaper)"
      }
    ]
  }
}
