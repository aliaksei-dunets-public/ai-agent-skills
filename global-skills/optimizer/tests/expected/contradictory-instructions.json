{
  "rubric": {
    "required": [
      "contradictory rules",
      "missing precedence",
      "run-to-run instability",
      "resolve explicitly with one canonical rule"
    ],
    "forbidden": [
      "silently pick one rule without stating precedence",
      "remove the approval requirement to save tokens"
    ]
  },
  "checks": {
    "mode": "quick",
    "min_findings": 1,
    "max_findings": 3,
    "no_measured_metrics": true,
    "required_concepts": [
      {
        "id": "contradiction",
        "any": [
          "contradict",
          "conflict",
          "inconsisten"
        ]
      },
      {
        "id": "precedence",
        "any": [
          "precedence",
          "priorit",
          "hierarch",
          "canonical"
        ]
      }
    ],
    "forbidden_patterns": [
      {
        "id": "fabricated-savings",
        "pattern": "\\d+(\\.\\d+)?\\s*%\\s*(fewer|less|lower|token|saving|reduction|cheaper)"
      }
    ]
  }
}
