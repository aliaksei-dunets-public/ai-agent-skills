{
  "rubric": {
    "required": [
      "delegation lacks admission control",
      "repeated context and analysis",
      "compact state and handoff recommended",
      "bounded fan-out or role consolidation"
    ],
    "forbidden": [
      "recommend more subagents without unique value"
    ]
  },
  "checks": {
    "mode": "standard",
    "min_findings": 1,
    "max_findings": 5,
    "no_measured_metrics": true,
    "required_concepts": [
      {
        "id": "admission-control",
        "any": [
          "admission",
          "always (launch|spawn|invoke)",
          "unconditional",
          "every (task|edit|change)",
          "small (code )?edit"
        ]
      },
      {
        "id": "repeated-context",
        "any": [
          "full (conversation )?history",
          "repeated context",
          "duplicat\\w* (context|analysis)"
        ]
      },
      {
        "id": "compact-handoff",
        "any": [
          "compact",
          "handoff",
          "delta",
          "scoped (input|context)"
        ]
      },
      {
        "id": "bounded-fanout",
        "any": [
          "fan-?out",
          "consolidat",
          "fewer (sub)?agents",
          "merge (roles|agents)",
          "bounded"
        ]
      }
    ],
    "forbidden_patterns": [
      {
        "id": "fabricated-savings",
        "pattern": "\\d+(\\.\\d+)?\\s*%\\s*(fewer|less|lower|token|saving|reduction|cheaper)"
      }
    ]
  }
}
