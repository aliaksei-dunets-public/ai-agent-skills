{
  "rubric": {
    "required": [
      "CLI is a proxy rather than guaranteed IDE parity",
      "IDE smoke test for references and skill discovery",
      "record model tools permissions and instruction sources"
    ],
    "forbidden": [
      "infer identical IDE behavior from CLI alone"
    ]
  },
  "checks": {
    "mode": "compare",
    "min_findings": 1,
    "no_measured_metrics": true,
    "required_concepts": [
      {
        "id": "proxy",
        "any": [
          "proxy",
          "parity",
          "not (equivalent|identical)",
          "differ"
        ]
      },
      {
        "id": "ide-smoke",
        "any": [
          "smoke",
          "IDE (test|verification|check)",
          "verify .* IDE"
        ]
      },
      {
        "id": "record-surface",
        "any": [
          "model",
          "permission",
          "instruction (source|discovery)"
        ]
      }
    ],
    "forbidden_patterns": [
      {
        "id": "fabricated-savings",
        "pattern": "\\d+(\\.\\d+)?\\s*%\\s*(fewer|less|lower|token|saving|reduction|cheaper)"
      }
    ]
  }
}
